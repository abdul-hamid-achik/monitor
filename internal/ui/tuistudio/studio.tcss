/* Monitor Studio's real palette (internal/ui/studio/theme.go), so the
   experimental Tuimark front-end reads as the same product as the Bubble
   Tea studio and the docs site. */
:root {
  --bg: #11161D;
  --fg: #F1F3F6;
  --muted: #A6AEBA;
  --accent: #FF8A80;
  --ok: #62B891;
  --warn: #D6A94F;
  --danger: #FF756D;
  --border: #3A414B;
  --focus: #FF8A80;
  --panel: #171D25;
}

@media (theme: light) {
  :root {
    --bg: #FBFAF8;
    --fg: #20252D;
    --muted: #5D6570;
    --accent: #B63838;
    --ok: #3C7658;
    --warn: #8A6116;
    --danger: #C02828;
    --border: #D9D6D1;
    --focus: #B63838;
    --panel: #F6F4F1;
  }
}

screen { color: $fg; background: $bg; }
#identity { height: 1; gap: 1; background: $panel; }
.brand { color: $accent; bold: true; }
.muted { color: $muted; }
.status { bold: true; }
.live { color: $ok; }
.paused { color: $warn; }
.waiting { color: $muted; }
.stale { color: $danger; }
.warn { color: $warn; }
/* The identity row's fixed content (brand, status, and time) is 27-30
   columns depending on the collection state; below that a long real
   hostname can push the last item past the row's right edge (L009), so it
   gets a bounded width (and an ellipsis, via wrap: truncate) at narrow
   widths only. */
@media (max-cols: 44) { .host { width: 10; wrap: truncate; } }

#nav { height: 1fr; gap: 2; }
.tab-label { color: $muted; }
.tab-label:selected { color: $accent; bold: true; }
.tab-label:disabled { dim: true; }

#keys { height: 1; background: $panel; }
.hint-key { color: $accent; bold: true; }
.hint-label { color: $muted; }

.pane { gap: 1; }
.panel { border: rounded; border-color: $border; title-color: $muted; }
/* The KPI grid is as tall as its rows (one row of 4 panels at 120
   columns, two at 80). At a narrow width it would need most of the tab
   (four stacked panels at 40 columns), so it stops at half the tab and
   scrolls, like #cores-view, instead of forcing #lower off the screen. */
#panels { layout: grid; grid-columns: 4; grid-min-width: 28; gap: 1; height: auto; max-height: 50%; overflow: scroll; }
.meter { height: 1; gap: 1; }
.meter-label { width: 16; }
.gauge { width: 1fr; bar: eighths; color: $accent; }
.spark { height: 1; color: $accent; width: 1fr; }
.spark-big { height: 5; color: $accent; }
.top-row { height: 1; gap: 1; }
/* The process name is the sole flexible child of its row (no spacer): it
   takes exactly the width left after the cpu% column, so a name longer
   than that gets an ellipsis (wrap: truncate) instead of overrunning the
   row (L009) the way an unconstrained auto-width text would. */
.top-name { width: 1fr; wrap: truncate; }
.num { content-align: end; }
.attention { height: 1; }

/* The activity and top-cpu row takes the rest of the tab, so no blank
   band opens under the KPI grid, and never less than its 7-row content. */
#lower { height: 1fr; min-height: 7; gap: 1; }
.activity { width: 3fr; }
.top { width: 2fr; }

#cores-view { scrollbar: auto; height: 1fr; }
/* gap: 1 separates the core columns; row-gap: 0 keeps the core rows
   adjacent, as the Bubble Tea studio draws them, so 12 cores in one
   column are 12 rows tall, not 23. */
#cores { layout: grid; grid-columns: 4; grid-min-width: 22; gap: 1; row-gap: 0; }
.core { height: 1; gap: 1; }
.core-label { width: 9; }

.breakdown { height: 1; gap: 1; }
.bd-label { width: 11; color: $muted; }
.mount-label { width: 24; }
/* At 40 columns the fixed mount-label plus the used/total note (up to ~20
   columns) does not fit the row alongside the gauge (L009); mount-label
   already truncates with an ellipsis (wrap="truncate" in the markup), so
   narrowing it here still shows a legible prefix while leaving the note
   intact. */
@media (max-cols: 44) { .mount-label { width: 12; } }

#filter-row { height: 1; gap: 1; }
#filter-row:focus-within > text { color: $accent; }
#procs { border: rounded; border-color: $border; scrollbar: auto; gap: 1; height: 1fr; }
#procs:focus { border-color: $focus; }
#procs > column { bold: true; color: $muted; }
#procs > item:checked { color: $accent; }
#procs > item.blocked { color: $danger; }
#procs > item > text.hot { color: $warn; }
/* The narrow-width column set comes from the columns' priority attributes
   (studio.tui), not from @media: c-io and c-user hide first, then c-thr,
   then c-mem, and only when the natural widths would not fit. */
#c-name { width: 1fr; min-width: 10; max-width: 44; }

#settings-list { border: rounded; border-color: $border; height: 1fr; }
#settings-list:focus { border-color: $focus; }
.setting-label { width: 24; }
.dirty { color: $warn; }
.error { color: $danger; }
.ok { color: $ok; }
#settings-status { height: 1; }

#kill { width: 80%; height: 12; }
#kill-rows { height: auto; }
.kill-row { height: 1; gap: 1; }
.kill-state { width: 10; }
.kill-pid { width: 7; }
#kill-actions { height: 1; gap: 2; }
.blocked { color: $danger; }
#detail { width: 86; max-width: 100%; height: 80%; }
#detail-rows { layout: grid; grid-columns: 2; grid-min-width: 38; gap: 0; }
.detail-row { height: 1; gap: 1; }
.detail-label { width: 12; color: $muted; }
#help { width: 60%; height: 80%; }
.help { layout: column; gap: 0; }
