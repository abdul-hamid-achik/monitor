{
  // Renderer: React + TS, bundled by Vite (type-checked only here).
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "types": []
  },
  "include": ["renderer/src/**/*.ts", "renderer/src/**/*.tsx", "renderer/src/vite-env.d.ts"]
}
